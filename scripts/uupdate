#!/usr/bin/env bash

set -euo pipefail

# Auto-elevate using sudo if not running as root
if [ "$(id -u)" -ne 0 ]; then
    exec sudo /usr/local/bin/uupdate "$@"
fi

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NORMAL='\033[0m'

# Disable color output if stdout is not a tty
if [ ! -t 1 ]; then
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NORMAL=''
fi

echo -e "${YELLOW}=== Ubuntu System Update ===${NORMAL}"
echo ""

# Start Snap refresh in background if installed
SNAP_PID=""
SNAP_LOG=""
SNAP_STATUS=""
if command -v snap >/dev/null 2>&1; then
    SNAP_LOG=$(mktemp)
    SNAP_STATUS=$(mktemp)
    rm -f "$SNAP_STATUS"
    (
        if snap refresh >"$SNAP_LOG" 2>&1; then
            echo 0 >"$SNAP_STATUS"
        else
            echo $? >"$SNAP_STATUS"
        fi
    ) &
    SNAP_PID=$!
    echo -e "${BLUE}ℹ${NORMAL} Started Snap refresh in background..."
fi

# Start APT update/upgrade/cleanup in background
APT_LOG=$(mktemp)
APT_STATUS=$(mktemp)
rm -f "$APT_STATUS"
(
    export DEBIAN_FRONTEND=noninteractive
    rc=0
    {
        apt update &&
        apt full-upgrade -y &&
        apt autoremove -y &&
        apt autoclean
    } >"$APT_LOG" 2>&1 || rc=$?
    echo "$rc" >"$APT_STATUS"
) &
APT_PID=$!
echo -e "${BLUE}ℹ${NORMAL} Started APT update & upgrade in background..."
echo ""

cleanup() {
    [ -n "${SNAP_LOG:-}" ] && rm -f "$SNAP_LOG"
    [ -n "${SNAP_STATUS:-}" ] && rm -f "$SNAP_STATUS"
    [ -n "${APT_LOG:-}" ] && rm -f "$APT_LOG"
    [ -n "${APT_STATUS:-}" ] && rm -f "$APT_STATUS"
}
trap cleanup EXIT

# Step 1: Check Docker images for updates (interactive, runs in foreground)
echo -e "${BLUE}[1/4]${NORMAL} Checking Docker images for updates..."
DOCKER_UPDATER=""
if [ -x /usr/local/bin/uupdate-docker-images ]; then
    DOCKER_UPDATER="/usr/local/bin/uupdate-docker-images"
elif [ -x "$(dirname "$0")/uupdate-docker-images" ]; then
    DOCKER_UPDATER="$(dirname "$0")/uupdate-docker-images"
fi

if [ "$(hostname -s)" = "stigberget" ] && [ -n "$DOCKER_UPDATER" ] && command -v docker >/dev/null 2>&1; then
    if ! "$DOCKER_UPDATER"; then
        echo -e "${YELLOW}⚠ Docker image update check failed (non-critical)${NORMAL}"
    fi
else
    echo -e "${BLUE}ℹ${NORMAL} Skipping Docker image updates (docker or uupdate-docker-images not found)"
fi
echo ""

report_snap() {
    local rc
    rc=$(cat "$SNAP_STATUS" 2>/dev/null || echo 1)
    if [ "$rc" -eq 0 ]; then
        local updated
        updated=$(awk '/refreshed$/ {print $1 " (" $2 ")"}' "$SNAP_LOG" 2>/dev/null || true)
        if [ -n "$updated" ]; then
            echo -e "${GREEN}✓ Snap refresh completed${NORMAL} — updated packages:"
            while IFS= read -r line; do
                echo "  - $line"
            done <<< "$updated"
        else
            echo -e "${GREEN}✓ Snap refresh completed${NORMAL} (all snaps up to date)"
        fi
    else
        echo -e "${YELLOW}⚠ Snap refresh failed (non-critical)${NORMAL}"
        if [ -s "$SNAP_LOG" ]; then
            tail -n 15 "$SNAP_LOG"
        fi
    fi
    echo ""
}

report_apt() {
    local rc
    rc=$(cat "$APT_STATUS" 2>/dev/null || echo 1)
    if [ "$rc" -eq 0 ]; then
        local updated
        updated=$(sed -n 's/^Unpacking \([^ ]*\) (\([^)]*\)).*/\1 (\2)/p' "$APT_LOG" 2>/dev/null | sort -u || true)
        if [ -n "$updated" ]; then
            local count
            count=$(echo "$updated" | wc -l)
            echo -e "${GREEN}✓ APT upgrade completed${NORMAL} — updated $count package(s):"
            while IFS= read -r line; do
                echo "  - $line"
            done <<< "$updated"
        else
            echo -e "${GREEN}✓ APT upgrade completed${NORMAL} (all packages up to date)"
        fi
    else
        echo -e "${RED}✗ APT update/upgrade failed${NORMAL}"
        if [ -s "$APT_LOG" ]; then
            tail -n 20 "$APT_LOG"
        fi
        return 1
    fi
    echo ""
}

# Step 2 & 3: Show background results (whatever finished first, then wait for remaining)
SNAP_REPORTED=0
APT_REPORTED=0

if [ -n "$SNAP_PID" ] && [ -f "$SNAP_STATUS" ]; then
    echo -e "${BLUE}[2/4]${NORMAL} Snap refresh result:"
    wait "$SNAP_PID" 2>/dev/null || true
    report_snap
    SNAP_REPORTED=1
fi

if [ -f "$APT_STATUS" ]; then
    step="[2/4]"
    [ "$SNAP_REPORTED" -eq 1 ] && step="[3/4]"
    echo -e "${BLUE}${step}${NORMAL} APT upgrade result:"
    wait "$APT_PID" 2>/dev/null || true
    report_apt
    APT_REPORTED=1
fi

if [ -n "$SNAP_PID" ] && [ "$SNAP_REPORTED" -eq 0 ]; then
    step="[2/4]"
    [ "$APT_REPORTED" -eq 1 ] && step="[3/4]"
    echo -e "${BLUE}${step}${NORMAL} Waiting for background Snap refresh to complete..."
    wait "$SNAP_PID" 2>/dev/null || true
    report_snap
    SNAP_REPORTED=1
fi

if [ "$APT_REPORTED" -eq 0 ]; then
    step="[2/4]"
    [ "$SNAP_REPORTED" -eq 1 ] && step="[3/4]"
    echo -e "${BLUE}${step}${NORMAL} Waiting for background APT upgrade to complete..."
    wait "$APT_PID" 2>/dev/null || true
    report_apt
    APT_REPORTED=1
fi

# Step 4: Check for reboot requirement
echo -e "${BLUE}[4/4]${NORMAL} Checking reboot requirement..."
if [ -f /var/run/reboot-required ]; then
    echo -e "${RED}┌────────────────────────────────────────┐${NORMAL}"
    echo -e "${RED}│  ⚠  SYSTEM REBOOT REQUIRED  ⚠          │${NORMAL}"
    echo -e "${RED}└────────────────────────────────────────┘${NORMAL}"
    if [ -f /var/run/reboot-required.pkgs ]; then
        echo -e "${YELLOW} Packages requiring reboot:${NORMAL}"
        while IFS= read -r pkg; do
            echo "  - $pkg"
        done < /var/run/reboot-required.pkgs
    fi
else
    echo -e "${GREEN}✓ No reboot required${NORMAL}"
fi
echo ""

echo -e "${GREEN}=== System Update Complete ===${NORMAL}"
